{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuietPad",
  "version": "0.1.0",
  "identifier": "com.quietpad.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "QuietPad",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["txt", "ps1", "psm1", "psd1", "bat", "cmd"],
        "name": "QuietPad.TextFile",
        "description": "Text or script file",
        "role": "Editor"
      }
    ]
  }
}
